<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane id="AnchorPane" prefHeight="550.0" prefWidth="420.0" styleClass="main-container" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.germannavarro.system.controller.RegistroController">
    <stylesheets>
        <URL value="@../resources/styles/RegistroStyles.css" />
    </stylesheets>
    <children>
        <VBox alignment="CENTER" spacing="12.0" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="35.0" AnchorPane.rightAnchor="35.0" AnchorPane.topAnchor="20.0">
            <children>
                <Label styleClass="title-label" text="Crear Cuenta" />

                <VBox spacing="4.0">
                    <children>
                        <Label text="Nombre" />
                        <TextField fx:id="txtNombre" promptText="Ingresa tu nombre" styleClass="text-field-custom" />
                    </children>
                </VBox>

                <VBox spacing="4.0">
                    <children>
                        <Label text="Apellido" />
                        <TextField fx:id="txtApellido" promptText="Ingresa tu apellido" styleClass="text-field-custom" />
                    </children>
                </VBox>

                <VBox spacing="4.0">
                    <children>
                        <Label text="Correo Electrónico" />
                        <TextField fx:id="txtEmail" promptText="ejemplo@correo.com" styleClass="text-field-custom" />
                    </children>
                </VBox>

                <VBox spacing="4.0">
                    <children>
                        <Label text="Usuario" />
                        <TextField fx:id="txtUser" promptText="Elige un usuario" styleClass="text-field-custom" />
                    </children>
                </VBox>

                <VBox spacing="4.0">
                    <children>
                        <Label text="Contraseña" />
                        <PasswordField fx:id="pwdPassword" promptText="Crea una contraseña" styleClass="text-field-custom" />
                    </children>
                </VBox>

                <HBox alignment="CENTER" spacing="15.0">
                    <children>
                        <Button fx:id="btnGuardar" onAction="#handleGuardar" styleClass="btn-primary" text="Guardar" />
                        <Button fx:id="btnVolver" onAction="#handleVolver" styleClass="btn-secondary" text="Cancelar" />
                    </children>
                    <VBox.margin>
                        <Insets top="15.0" />
                    </VBox.margin>
                </HBox>
            </children>
        </VBox>
    </children>
</AnchorPane>